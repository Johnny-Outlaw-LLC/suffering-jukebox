#!/bin/sh
# Suffering Jukebox pre-push hook.
#
# Blocks a push that changes public/index.html without a Change Log entry
# dated today. Install with: sh scripts/install-hooks.sh
#
# Skip for a genuinely invisible-to-users change by adding a trailer line to
# one of the commit messages being pushed:
#
#     No-Changelog: server-only, nothing visible on screen
#
# The trailer must start its own line. Merely mentioning it mid-sentence does
# not count, so docs and commit prose can talk about it safely.

repo_root=$(git rev-parse --show-toplevel)
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # branch deletion

  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"             # new branch: commits not already pushed
  else
    range="$remote_sha..$local_sha"
  fi

  # Files touched by the commits being pushed (not the working tree).
  changed=$(git log --format= --name-only $range 2>/dev/null | sort -u)
  echo "$changed" | grep -qx 'public/index.html' || continue

  if git log --format=%B $range 2>/dev/null | grep -qiE '^[[:space:]]*No-Changelog:'; then
    echo "pre-push: No-Changelog trailer found, skipping Change Log check."
    continue
  fi

  # Check the blob being pushed, not the working tree.
  git show "$local_sha:public/index.html" | node "$repo_root/scripts/check-changelog.js" - || exit 1
done

exit 0
