<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Granted to team 2J69KHU242 (case 22032312). It is a managed capability,
	     so it can only ride on an explicit App ID - the wildcard team profile
	     (2J69KHU242.*) cannot carry it, and signing fails with "Entitlement
	     com.apple.developer.carplay-audio not found" until the App ID
	     com.johnnyoutlaw.sufferingjukebox is registered with the CarPlay
	     capability. Note that ad-hoc simulator signing drops this entitlement
	     entirely, so a simulator build alone does not prove CarPlay works. -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
</dict>
</plist>
