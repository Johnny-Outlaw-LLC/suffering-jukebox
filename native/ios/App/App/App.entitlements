<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Requires Apple's approval before it can be used on a device or in
	     TestFlight: developer.apple.com/contact/carplay. Simulator builds do
	     not validate it, so CarPlay can be developed against the simulator
	     while that request is pending. -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
</dict>
</plist>
