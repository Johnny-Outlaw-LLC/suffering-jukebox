<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Record Keeper is a new explicit App ID. Apple must approve or enable
         CarPlay audio for com.johnnyoutlaw.recordkeeper; Listening Party
         approval and provisioning do not transfer automatically. -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
