{
  "appId": "com.johnnyoutlaw.recordkeeper",
  "appName": "Record Keeper",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#171717"
  },
  "android": {
    "backgroundColor": "#171717"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    }
  },
  "server": {
    "iosScheme": "https",
    "androidScheme": "https",
    "hostname": "app.recordkeeper.stream",
    "allowNavigation": [
      "recordkeeper.stream",
      "*.recordkeeper.stream"
    ]
  }
}
