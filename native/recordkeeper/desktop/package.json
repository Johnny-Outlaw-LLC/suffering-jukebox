{
  "name": "record-keeper-desktop",
  "productName": "Record Keeper",
  "version": "1.0.2",
  "description": "Record Keeper for Windows and Mac: the player in its own window, with a system tray icon and a Mini Player.",
  "author": "Johnny Outlaw LLC",
  "homepage": "https://recordkeeper.stream",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env RK_DESKTOP_URL=http://localhost:3021 electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg --universal"
  },
  "devDependencies": {
    "cross-env": "10.1.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.johnnyoutlaw.recordkeeper.desktop",
    "productName": "Record Keeper",
    "copyright": "Copyright © 2026 Johnny Outlaw LLC",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "lib.js", "preload.js", "mini/**", "assets/**", "package.json"],
    "protocols": [
      { "name": "Record Keeper sign-in", "schemes": ["com.johnnyoutlaw.recordkeeper"] }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "artifactName": "Record-Keeper-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Record Keeper",
      "uninstallDisplayName": "Record Keeper",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "hardenedRuntime": true,
      "artifactName": "Record-Keeper-${version}.${ext}"
    }
  }
}
